# ============================================================
# .env.example — copia este archivo como .env y rellena los valores reales.
# NUNCA commitees .env con valores reales.
# ============================================================

# Base de datos principal (SQLite local o URL de conexión remota)
DATABASE_URL=sqlite:///./barberia.db

# Supabase (si se migra a PostgreSQL)
SUPABASE_DB_URL=postgresql://user:password@host:5432/database

# Twilio — notificaciones WhatsApp/SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# MercadoPago — pagos
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
